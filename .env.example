# ─────────────────────────────────────────────────────────────
# Oori Woodworking — environment variables
# Copy this file to `.env.local` and fill in the values.
# The site works WITHOUT any of these (leads are logged + WhatsApp
# fallback still works), but configure them for full functionality.
# ─────────────────────────────────────────────────────────────

# Supabase — stores every quote request in the `leads` table and powers
# the /admin CRM. Get these from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Settings → API → service_role) — SECRET, server-only.
# Required for the /admin CRM to read/update leads. Never expose this to
# the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (optional) — sends an email to the owner on each lead.
# Uses Resend (https://resend.com). Leave blank to disable email.
RESEND_API_KEY=
# Where lead notifications are sent, and the verified "from" address.
LEAD_NOTIFICATION_EMAIL=oori@example.com
LEAD_FROM_EMAIL=onboarding@resend.dev

# Public contact details (shown on the site + used for WhatsApp click-to-chat).
# WhatsApp number in international format WITHOUT + or spaces, e.g. 972501234567
NEXT_PUBLIC_WHATSAPP_NUMBER=972500000000
NEXT_PUBLIC_CONTACT_PHONE=+972-50-000-0000
NEXT_PUBLIC_CONTACT_EMAIL=oori@example.com

# Public site URL (used for SEO / Open Graph, and links in CRM emails).
# e.g. https://oori.co.il
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# /admin CRM — lead pipeline, notes, follow-up reminders.
# Without these two set, /admin/login shows a "not configured" message.
# ─────────────────────────────────────────────────────────────

# The password used to log into /admin. Pick something long and random —
# there is no rate-limiting beyond a small fixed delay on failed attempts.
ADMIN_PASSWORD=

# A long random secret used to sign admin login sessions (NOT the same as
# the password). Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional — protects the daily follow-up reminder cron endpoint
# (/api/cron/follow-ups). If set, Vercel automatically sends it as a
# bearer token when triggering the scheduled job (see vercel.json).
# Generate one with: openssl rand -hex 32
CRON_SECRET=
